# Copy values out of band to /etc/astra-emailautomation/astra.env.
# Never place real credentials in this repository.
ASTRA_EXPECTED_GIT_COMMIT=REPLACE_WITH_DEPLOYED_COMMIT

DASHBOARD_AUTH_USERNAME=REPLACE_WITH_ADMIN_USERNAME
DASHBOARD_AUTH_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
DASHBOARD_SESSION_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET

RESTIC_REPOSITORY=/var/lib/astra-backups
RESTIC_PASSWORD_FILE=/etc/astra-emailautomation/restic-password
ASTRA_RESTIC_CHECK_SUBSET=1/100

HANDOFF_MAC_HOST=REPLACE_WITH_MAC_TAILSCALE_SSH_HOST
HANDOFF_MAC_REPO=REPLACE_WITH_MAC_REPOSITORY_ABSOLUTE_PATH
HANDOFF_CLOUD_HOST=REPLACE_WITH_CLOUD_TAILSCALE_SSH_HOST
HANDOFF_CLOUD_REPO=/opt/astra/emailautomation
