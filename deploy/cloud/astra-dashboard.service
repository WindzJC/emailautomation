[Unit]
Description=Astra email automation dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=astra
Group=astra
WorkingDirectory=/opt/astra/emailautomation
EnvironmentFile=/etc/astra-emailautomation/astra.env
Environment=ASTRA_MACHINE_ID=cloud
Environment=ASTRA_DISABLE_DOTENV=1
Environment=RUNTIME_BACKEND=systemd
Environment=ASTRA_SYSTEMCTL_BIN=/usr/bin/systemctl
Environment=DASHBOARD_ENABLE_LIVE_ACTIONS=1
Environment=DASHBOARD_ALLOW_AUTO_START=0
Environment=LIVE_DASHBOARD_HOST=127.0.0.1
Environment=LIVE_DASHBOARD_PORT=8000
ExecStartPre=/opt/astra/emailautomation/.venv/bin/python dashboard_security.py --host 127.0.0.1 --tunnel
ExecStart=/opt/astra/emailautomation/.venv/bin/python -m uvicorn live_dashboard:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=10s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/astra/emailautomation/data
ReadWritePaths=/opt/astra/emailautomation/_important
ReadWritePaths=/opt/astra/emailautomation/.runtime_handoff

[Install]
WantedBy=multi-user.target
