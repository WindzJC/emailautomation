[Unit]
Description=Astra email sender profile %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=astra
Group=astra
WorkingDirectory=/opt/astra/emailautomation
EnvironmentFile=/etc/astra-emailautomation/profiles/%i.env
Environment=ASTRA_MACHINE_ID=cloud
Environment=ASTRA_DISABLE_DOTENV=1
RuntimeDirectory=astra-emailautomation
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecCondition=/opt/astra/emailautomation/deploy/cloud/verify.sh --profile %i --require-authority
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 75 /run/astra-emailautomation/sender-%i.lock /opt/astra/emailautomation/.venv/bin/python send_shard.py --profile %i
Restart=on-failure
RestartPreventExitStatus=75
RestartSec=30s
TimeoutStopSec=90s
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/astra/emailautomation/data
ReadWritePaths=/opt/astra/emailautomation/_important
ReadWritePaths=/opt/astra/emailautomation/.runtime_handoff

[Install]
WantedBy=multi-user.target
