#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${HANDOFF_PYTHON:-python3}"

runtime_handoff() {
  "${PYTHON_BIN}" "${REPO_ROOT}/tools/runtime_handoff.py" --repo "${REPO_ROOT}" "$@"
}

transport_handoff() {
  "${PYTHON_BIN}" "${REPO_ROOT}/tools/handoff_transport.py" --repo "${REPO_ROOT}" "$@"
}

case "${1:-}" in
  switch-to-mac)
    transport_handoff switch --target mac
    ;;
  switch-to-windows)
    transport_handoff switch --target windows-wsl
    ;;
  switch-to-cloud)
    transport_handoff switch --target cloud
    ;;
  takeover-from-mac)
    transport_handoff takeover --source mac --target windows-wsl
    ;;
  prepare-export)
    [[ $# -eq 2 ]] || {
      echo "Usage: ./handoff prepare-export TARGET" >&2
      exit 2
    }
    transport_handoff prepare-export --target "$2"
    ;;
  status)
    runtime_handoff status
    ;;
  config)
    transport_handoff config
    ;;
  doctor)
    shift
    if [[ $# -gt 1 ]]; then
      echo "Usage: ./handoff doctor [mac|windows-wsl|cloud]" >&2
      exit 2
    fi
    if [[ $# -eq 1 ]]; then
      transport_handoff doctor --target "$1"
    else
      transport_handoff doctor
    fi
    ;;
  receive)
    [[ $# -ge 2 ]] || {
      echo "Usage: ./handoff receive BUNDLE [RESUME OPTIONS]" >&2
      exit 2
    }
    shift
    runtime_handoff import "$@"
    ;;
  verify)
    [[ $# -eq 2 ]] || {
      echo "Usage: ./handoff verify BUNDLE" >&2
      exit 2
    }
    runtime_handoff verify "$2"
    ;;
  activate)
    shift
    runtime_handoff activate "$@"
    ;;
  emergency-takeover)
    shift
    runtime_handoff emergency-takeover "$@"
    ;;
  rollback)
    shift
    runtime_handoff rollback "$@"
    ;;
  *)
    echo "Usage: ./handoff {switch-to-mac|switch-to-windows|switch-to-cloud|takeover-from-mac|status|config|doctor [TARGET]|verify BUNDLE|activate ...|emergency-takeover ...|rollback ...}" >&2
    exit 2
    ;;
esac
